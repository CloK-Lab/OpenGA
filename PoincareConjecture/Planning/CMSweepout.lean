import OpenGALib.Riemannian.Surface.Width
import DifferentialGeometry.Analysis.Sobolev.Intrinsic.Lp

/-!
# Colding--Minicozzi sweepouts

Source: https://arxiv.org/html/0707.0108v1, Section 1.1, (1.1)--(1.2).

This is a development file: definitions are explicit, and unfinished analytic
properties are stated as theorems with `sorry`. It is not imported by OpenGALib.

We use a fixed Euclidean realization of the target, represented by a subset K.
For the CM application N is the round two-sphere and K is the image of a closed
Riemannian manifold under a smooth isometric embedding. Neither existence of
that embedding nor agreement with the existing intrinsic smooth-map energy is
proved here. The definitions make sense for any K; no manifold structure of K
is needed merely to define its mapping space.

Coordinate weak gradients are general L2 fields, not smooth fields. Choosing
representatives must be justified by the weak-gradient uniqueness task below.
The topology is generated by the explicit C0-plus-W12 distance balls;
its metric laws and the standard strong W12 interpretation remain proof tasks.
-/

noncomputable section

open Bundle MeasureTheory Set
open scoped Manifold ContDiff ENNReal BigOperators
open DifferentialGeometry DifferentialGeometry.Integral.Measure
open DifferentialGeometry.Analysis.Sobolev.IntrinsicLp

namespace OpenGA.ColdingMinicozzi

variable {N : Type*} [TopologicalSpace N] [ChartedSpace Surface.Model N]
  [IsManifold 𝓘(ℝ, Surface.Model) ∞ N] [T2Space N] [CompactSpace N]

private local instance : MeasurableSpace N := borel N
private local instance : BorelSpace N := ⟨rfl⟩

abbrev Parameter := Icc (0 : ℝ) 1

abbrev Ambient (d : ℕ) := EuclideanSpace ℝ (Fin d)

/-- First analytic task: two L2 weak gradients of the same scalar function on
the closed source surface agree almost everywhere. No smoothness of the
function or its gradients is assumed, and no chosen representative is involved.
This makes subsequent energy and distance constructions independent of the
choice of weak-gradient representative. -/
theorem weakGradient_ae_unique
    (q : SmoothRiemannianMetric 𝓘(ℝ, Surface.Model) N)
    {u : N → ℝ} {G₁ G₂ : N → Surface.Model}
    (h₁ : HasWeakRiemannianGradLp (I := 𝓘(ℝ, Surface.Model)) q u G₁)
    (h₂ : HasWeakRiemannianGradLp (I := 𝓘(ℝ, Surface.Model)) q u G₂)
    (hG₁ : MemLp (fun x => Real.sqrt (q.inner x (G₁ x) (G₁ x))) 2
      (riemannianVolumeMeasure 𝓘(ℝ, Surface.Model) N q))
    (hG₂ : MemLp (fun x => Real.sqrt (q.inner x (G₂ x) (G₂ x))) 2
      (riemannianVolumeMeasure 𝓘(ℝ, Surface.Model) N q)) :
    G₁ =ᵐ[riemannianVolumeMeasure 𝓘(ℝ, Surface.Model) N q] G₂ := by
  sorry

/-- Continuous maps with coordinatewise weak first derivatives in L2.
Continuity supplies a pointwise representative; membership in K is pointwise. -/
structure C0W12Map (q : SmoothRiemannianMetric 𝓘(ℝ, Surface.Model) N)
    {d : ℕ} (K : Set (Ambient d)) where
  map : C(N, Ambient d)
  mapsTo : ∀ x, map x ∈ K
  sobolev : ∀ i : Fin d,
    MemW1pIntrinsicLp (I := 𝓘(ℝ, Surface.Model)) q 2 (fun x => map x i)

namespace C0W12Map

variable {q : SmoothRiemannianMetric 𝓘(ℝ, Surface.Model) N}
  {d : ℕ} {K : Set (Ambient d)}

/-- Constant maps belong to the space without any smooth-gradient assumption
on its other members. This also supplies the endpoint examples. -/
def const (q : SmoothRiemannianMetric 𝓘(ℝ, Surface.Model) N)
    (c : Ambient d) (hc : c ∈ K) : C0W12Map q K where
  map := ContinuousMap.const N c
  mapsTo := fun _ => hc
  sobolev := fun i => MemW1pIntrinsicLp_of_contMDiff q 2
    (contMDiff_const : ContMDiff 𝓘(ℝ, Surface.Model) 𝓘(ℝ, ℝ) ∞ (fun _ : N => c i))

/-- A representative of the weak gradient of one ambient coordinate. -/
def weakGradient (f : C0W12Map q K) (i : Fin d) : N → Surface.Model :=
  Classical.choose (f.sobolev i).2

theorem weakGradient_spec (f : C0W12Map q K) (i : Fin d) :
    HasWeakRiemannianGradLp (I := 𝓘(ℝ, Surface.Model)) q
      (fun x => f.map x i) (f.weakGradient i) ∧
    MemLp (fun x => Real.sqrt (q.inner x (f.weakGradient i x)
      (f.weakGradient i x))) 2 (riemannianVolumeMeasure 𝓘(ℝ, Surface.Model) N q) :=
  Classical.choose_spec (f.sobolev i).2

/-- Uniqueness is almost everywhere, not equality of chosen representatives. -/
theorem weakGradient_unique (f : C0W12Map q K) (i : Fin d)
    (G : N → Surface.Model)
    (hG : HasWeakRiemannianGradLp (I := 𝓘(ℝ, Surface.Model)) q
      (fun x => f.map x i) G)
    (hG2 : MemLp (fun x => Real.sqrt (q.inner x (G x) (G x))) 2
      (riemannianVolumeMeasure 𝓘(ℝ, Surface.Model) N q)) :
    f.weakGradient i =ᵐ[riemannianVolumeMeasure 𝓘(ℝ, Surface.Model) N q] G := by
  exact weakGradient_ae_unique q (f.weakGradient_spec i).1 hG
    (f.weakGradient_spec i).2 hG2

/-- Sum of intrinsic L2 differences of the ambient-coordinate gradients. -/
def gradientEDistance (f h : C0W12Map q K) : ℝ≥0∞ :=
  ∑ i : Fin d, eLpNorm (fun x => Real.sqrt
    (q.inner x (f.weakGradient i x - h.weakGradient i x)
      (f.weakGradient i x - h.weakGradient i x))) 2
    (riemannianVolumeMeasure 𝓘(ℝ, Surface.Model) N q)

theorem gradientEDistance_lt_top (f h : C0W12Map q K) :
    f.gradientEDistance h < ⊤ := by
  sorry

/-- Strong W12 difference: both the function and its weak gradient occur. -/
def sobolevEDistance (f h : C0W12Map q K) : ℝ≥0∞ :=
  (∑ i : Fin d, eLpNorm (fun x => f.map x i - h.map x i) 2
    (riemannianVolumeMeasure 𝓘(ℝ, Surface.Model) N q)) +
    f.gradientEDistance h

theorem sobolevEDistance_lt_top (f h : C0W12Map q K) :
    f.sobolevEDistance h < ⊤ := by
  sorry

/-- The uniform C0 distance plus the strong W12 difference. -/
def distance (f h : C0W12Map q K) : ℝ :=
  dist f.map h.map + (f.sobolevEDistance h).toReal

theorem distance_self (f : C0W12Map q K) : f.distance f = 0 := by
  sorry

theorem distance_comm (f h : C0W12Map q K) : f.distance h = h.distance f := by
  sorry

theorem distance_triangle (f h k : C0W12Map q K) :
    f.distance k ≤ f.distance h + h.distance k := by
  sorry

theorem distance_eq_zero_iff (f h : C0W12Map q K) :
    f.distance h = 0 ↔ f = h := by
  sorry

/-- Explicit ball-generated topology; no topology or energy-continuity
assumption is supplied by the caller. -/
instance : TopologicalSpace (C0W12Map q K) :=
  TopologicalSpace.generateFrom
    {U | ∃ f : C0W12Map q K, ∃ ε : ℝ, 0 < ε ∧ U = {h | f.distance h < ε}}

/-- CM energy (1.2) in the fixed Euclidean realization, with the domain
metric contracting weak derivatives. Extended values avoid implicit finiteness. -/
def energy (f : C0W12Map q K) : ℝ≥0∞ :=
  (1 / 2 : ℝ≥0∞) * ∑ i : Fin d,
    ∫⁻ x, ENNReal.ofReal (q.inner x (f.weakGradient i x) (f.weakGradient i x))
      ∂(riemannianVolumeMeasure 𝓘(ℝ, Surface.Model) N q)

theorem energy_lt_top (f : C0W12Map q K) : f.energy < ⊤ := by
  sorry

theorem continuous_energy :
    Continuous (fun f : C0W12Map q K => f.energy.toReal) := by
  sorry

/-- Check that strong mapping-space continuity retains joint C0 continuity. -/
theorem continuous_evaluation :
    Continuous (fun p : C0W12Map q K × N => p.1.map p.2) := by
  sorry

end C0W12Map

variable (q : SmoothRiemannianMetric 𝓘(ℝ, Surface.Model) N)
  {d : ℕ} (K : Set (Ambient d))

/-- Endpoints are constant maps, with possibly different constants.
Homotopies below may move these constants. -/
def HasConstantEndpoints (γ : C(Parameter, C0W12Map q K)) : Prop :=
  (∃ c ∈ K, ∀ x, (γ ⟨0, by constructor <;> norm_num⟩).map x = c) ∧
  (∃ c ∈ K, ∀ x, (γ ⟨1, by constructor <;> norm_num⟩).map x = c)

/-- The sweepout space Ω of CM Section 1.1, in a fixed Euclidean realization. -/
structure Sweepout where
  curve : C(Parameter, C0W12Map q K)
  endpoints : HasConstantEndpoints q K curve

namespace Sweepout

variable {q K}

/-- An actual constant sweepout. Its construction does not use any of the
unfinished analytic theorems in this file. -/
def const (q : SmoothRiemannianMetric 𝓘(ℝ, Surface.Model) N)
    (c : Ambient d) (hc : c ∈ K) : Sweepout q K where
  curve := ContinuousMap.const Parameter (C0W12Map.const q c hc)
  endpoints := ⟨⟨c, hc, fun _ => rfl⟩, ⟨c, hc, fun _ => rfl⟩⟩

/-- Homotopy through sweepouts, continuous in C0 intersect strong W12.
This does not freeze the endpoint constants throughout the homotopy. -/
def Homotopic (β γ : Sweepout q K) : Prop :=
  β.curve.HomotopicWith γ.curve (HasConstantEndpoints q K)

theorem homotopic_refl (β : Sweepout q K) : β.Homotopic β :=
  ContinuousMap.HomotopicWith.refl β.curve β.endpoints

theorem Homotopic.symm {β γ : Sweepout q K} (h : β.Homotopic γ) :
    γ.Homotopic β := ContinuousMap.HomotopicWith.symm h

theorem Homotopic.trans {β γ δ : Sweepout q K}
    (h : β.Homotopic γ) (k : γ.Homotopic δ) : β.Homotopic δ :=
  ContinuousMap.HomotopicWith.trans h k

/-- Supremum first; attainment is a theorem, not part of the definition. -/
def maxEnergy (γ : Sweepout q K) : ℝ≥0∞ := ⨆ t, (γ.curve t).energy

/-- CM (1.1): infimum over Ω_β, not an attained outer minimum. -/
def width (β : Sweepout q K) : ℝ≥0∞ :=
  ⨅ γ : Sweepout q K, ⨅ (_ : β.Homotopic γ), γ.maxEnergy

theorem width_le_maxEnergy {β γ : Sweepout q K} (h : β.Homotopic γ) :
    β.width ≤ γ.maxEnergy :=
  iInf_le_of_le γ (iInf_le _ h)

/-- Replacement milestone in the CM mapping space, after its analytic
properties have been proved. No smooth-slice hypothesis is imposed here. -/
theorem finite_width (β : Sweepout q K) :
    Continuous (fun t => (β.curve t).energy.toReal) ∧
    (∃ t : Parameter, β.maxEnergy = (β.curve t).energy) ∧
    β.maxEnergy < ⊤ ∧ β.width < ⊤ := by
  sorry

end Sweepout
end OpenGA.ColdingMinicozzi
